{
  "name": "aeod-gestion",
  "private": true,
  "version": "1.0.0",
  "description": "Software de gestión de la clínica AEOD (personal: recepción, odontólogos, coordinación y administración)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --max-warnings=0 src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:tipos": "openapi-typescript http://localhost:8080/v3/api-docs -o src/shared/api/esquema.ts && prettier --write src/shared/api/esquema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
